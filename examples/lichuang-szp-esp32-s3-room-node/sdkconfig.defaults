CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_SR_WN_WN9_HIESP=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_USE_CLIB_MALLOC=y
# The ST7789 flush buffers are small internal-DMA chunks (see main.c); node
# task stacks and DMA can only come from internal RAM, so give them the budget.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=262144
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_USE_SNAPSHOT=y
# esp_new_jpeg decodes straight into LVGL draw buffers; its output buffer must
# be 16-byte aligned. Stride align stays 1 so RGB565 rows are tightly packed.
CONFIG_LV_DRAW_BUF_ALIGN=16
# Node + operator clients each run a component task and a websocket task, all
# four on internal stacks. Measured on this board, the operator's websocket
# task found only a 7.5 KiB contiguous internal block once the node session,
# display, and audio were up, so 8 KiB failed to start. The websocket task only
# frames I/O and enqueues messages (parsing runs on the component task), so
# 6 KiB is sufficient for a ws:// Gateway; esp_websocket_client defaults to 4.
CONFIG_ESP_OPENCLAW_NODE_TASK_STACK_SIZE=8192
CONFIG_ESP_OPENCLAW_NODE_TRANSPORT_TASK_STACK_SIZE=6144
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# PSRAM-first memory policy, matching the Waveshare S3 room node and the
# esp-webrtc-solution demo configs.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Keep node/websocket tasks above the bulk audio encoder workers so
# node.invoke (face.set, talk.stop) is still served during a call.
CONFIG_ESP_OPENCLAW_NODE_TASK_PRIORITY=11
CONFIG_ESP_OPENCLAW_NODE_TRANSPORT_TASK_PRIORITY=11
# 30 Hz refresh: a full 320x240 RGB565 frame over 40 MHz SPI is ~31 ms of bus
# time, so the 60 Hz AMOLED cadence is not sustainable on this panel; the face
# only redraws its dirty regions.
CONFIG_LV_DEF_REFR_PERIOD=33
# On the S3, IRAM and DRAM share one SRAM pool. The Wi-Fi IRAM fast paths cost
# tens of KiB of heap that this board needs for the 8 KiB internal stacks the
# AFE open/close sync tasks require around every Talk call (measured: without
# this, ambient capture failed to reopen after a call). Audio-only Talk does
# not need the extra Wi-Fi throughput.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# Talk runs through the local voice bridge (STT/agent/TTS on a LAN host) instead
# of a Gateway WebRTC realtime provider. Set the bridge URL once over the USB
# console: bridge url ws://<host>:18790
CONFIG_OPENCLAW_ROOM_TALK_BACKEND_BRIDGE=y
